# ─────────────────────────────────────────────
# RealDocConverter — environment template
# Copy to .env and fill in real values.
# ─────────────────────────────────────────────

NODE_ENV=development

# ── API
API_PORT=4000
API_BASE_URL=http://localhost:4000
API_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
API_JWT_EXPIRES_IN=7d

# ── Web
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=docuconvert
DATABASE_PASSWORD=docuconvert_dev_pw
DATABASE_NAME=docuconvert

# ── Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ── Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/realdocconverter/storage

# ── Uploads
UPLOAD_MAX_SIZE_MB=50
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/tiff,image/bmp,application/pdf

# ── Job retention (hours)
FILE_RETENTION_HOURS=24